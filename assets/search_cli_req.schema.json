{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "title": "TikTok 关键词搜索 - 命令行入参",
    "description": "非法枚举和数量会直接失败，不会改成默认值。关键词按 Unicode 码点计 1-100。",
    "required": ["keyword"],
    "properties": {
        "keyword": {
            "type": "string",
            "description": "搜索关键词。1-100 个字符，不能是链接，不含 < > \" '",
            "minLength": 1,
            "maxLength": 100
        },
        "sort": {
            "type": "integer",
            "description": "0=相关度，1=最多点赞。没有「最新」这一档",
            "default": 0,
            "enum": [0, 1]
        },
        "time": {
            "type": "integer",
            "description": "0=全部，1=近1日，7=近7日，30=近1月，90=近3月，180=近6月",
            "default": 0,
            "enum": [0, 1, 7, 30, 90, 180]
        },
        "limit": {
            "type": "integer",
            "description": "获取数量。包月 TOKEN 超过 30 时接口返回 errcode 14",
            "minimum": 1,
            "maximum": 10000,
            "default": 10
        }
    },
    "additionalProperties": false
}
