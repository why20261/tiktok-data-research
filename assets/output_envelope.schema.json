{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "title": "命令输出信封",
    "description": "三个命令 stdout 的统一结构。成功、空结果、错误都使用本信封。stderr 只有日志，不是本结构。",
    "required": [
        "status",
        "error_code",
        "message",
        "timestamp",
        "request",
        "metadata",
        "results"
    ],
    "properties": {
        "status": {
            "type": "string",
            "enum": ["success", "empty", "error"],
            "description": "success 为有结果；empty 为接口已完成但没有匹配内容，退出码仍为 0；error 为失败"
        },
        "error_code": {
            "type": "string",
            "description": "OK、NO_MATCH、INVALID_KEYWORD、INVALID_URL、INVALID_ARGS、AUTH_REQUIRED、AUTH_ERROR、TIMEOUT、NETWORK_ERROR、HTTP_5xx、HTTP_429、API_ERROR，或接口 errcode 的十进制字符串"
        },
        "message": {
            "type": "string",
            "description": "给人读的说明"
        },
        "timestamp": {
            "type": "string",
            "description": "输出时间，北京时间，格式如 2026/9/4 20:13:20，月和日不补零"
        },
        "request": {
            "type": "object",
            "description": "本次实际使用的参数。参数尚未解析成功时只有 command",
            "required": ["command"],
            "properties": {
                "command": {
                    "type": "string",
                    "enum": ["search", "post", "comment"],
                    "description": "命令名"
                },
                "keyword_raw": {
                    "type": "string",
                    "description": "搜索：用户原始关键词"
                },
                "keyword": {
                    "type": "string",
                    "description": "搜索：整理空白后实际使用的关键词"
                },
                "sort": {
                    "type": "number",
                    "description": "搜索：0 相关度，1 最多点赞。作品：0 最新，1 最热"
                },
                "time": {
                    "type": "number",
                    "description": "搜索：0 全部，1 近 1 日，7 近 7 日，30 近 1 月，90 近 3 月，180 近 6 月"
                },
                "url_raw": {
                    "type": "string",
                    "description": "作品或评论：用户原始链接或 id"
                },
                "url": {
                    "type": "string",
                    "description": "作品或评论：规范后的链接或 id。创建和查询使用同一字符串"
                },
                "limit": {
                    "type": "number",
                    "description": "1-10000 的整数。参数尚未通过校验时可能仍是用户传入的原值"
                }
            }
        },
        "metadata": {
            "type": "object",
            "required": ["skill_version", "runtime_version", "execution_time"],
            "properties": {
                "skill_version": { "type": "string", "description": "技能版本" },
                "runtime_version": { "type": "string", "description": "Node.js 版本" },
                "execution_time": {
                    "type": "number",
                    "description": "本次执行耗时，毫秒。未捕获异常时为 0"
                }
            }
        },
        "results": {
            "description": "error 与 empty 时为 null。三个命令成功时都是数组。空字符串和数字 0 的字段可能不在元素里",
            "oneOf": [
                { "type": "null" },
                { "type": "array", "items": { "type": "object" } }
            ]
        }
    }
}
