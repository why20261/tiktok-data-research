{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "title": "TikTok博主作品获取 - API出参",
    "description": "TikTok实时获取博主作品, API出参Schema详解",
    "properties": {
        "aweme_id": {
            "type": "string",
            "description": "TikTok视频ID"
        },
        "desc": {
            "type": "string",
            "description": "TikTok视频描述"
        },
        "create_time": {
            "type": "number",
            "description": "TikTok视频创建时间戳"
        },
        "music_title": {
            "type": "string",
            "description": "TikTok视频音乐标题"
        },
        "music_author": {
            "type": "string",
            "description": "TikTok视频音乐作者"
        },
        "music_duration": {
            "type": "number",
            "description": "TikTok视频音乐时长"
        },
        "music_play_url": {
            "type": "string",
            "description": "TikTok视频音乐播放URL"
        },
        "video_url": {
            "type": "array",
            "description": "视频播放地址、视频下载地址",
            "items": {
                "type": "string",
                "description": "视频播放地址、视频下载地址"
            }
        },
        "video_cover": {
            "type": "string",
            "description": "TikTok视频封面URL"
        },
        "video_duration": {
            "type": "number",
            "description": "TikTok视频时长"
        },
        "comment_count": {
            "type": "number",
            "description": "TikTok视频评论数"
        },
        "digg_count": {
            "type": "number",
            "description": "TikTok视频点赞数"
        },
        "download_count": {
            "type": "number",
            "description": "TikTok视频下载数"
        },
        "play_count": {
            "type": "number",
            "description": "TikTok视频播放数"
        },
        "share_count": {
            "type": "number",
            "description": "TikTok视频分享数"
        },
        "forward_count": {
            "type": "number",
            "description": "TikTok视频转发数"
        },
        "whatsapp_share_count": {
            "type": "number",
            "description": "TikTok视频WhatsApp分享数"
        },
        "collect_count": {
            "type": "number",
            "description": "TikTok视频收藏数"
        },
        "repost_count": {
            "type": "number"
        },
        "tags": {
            "type": "array",
            "description": "TikTok视频标签",
            "items": {
                "type": "string",
                "description": "TikTok视频标签"
            }
        },
        "suggest_words": {
            "type": "array",
            "description": "TikTok小蓝词",
            "items": {
                "type": "string",
                "description": "TikTok小蓝词, 评论框顶端显示的建议词"
            }
        },
        "share_url": {
            "type": "string",
            "description": "TikTok视频分享URL"
        }
    }
}