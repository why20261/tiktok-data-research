{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "title": "TikTok评论获取 - API出参",
    "description": "TikTok获取作品评论, API出参Schema详解",
    "properties": {
        "cid": {
            "type": "string",
            "description": "TikTok评论ID"
        },
        "text": {
            "type": "string",
            "description": "TikTok评论内容"
        },
        "create_time": {
            "type": "number",
            "description": "TikTok评论发布时间戳"
        },
        "digg_count": {
            "type": "number",
            "description": "TikTok评论点赞数"
        },
        "user_id": {
            "type": "string",
            "description": "TikTok评论者用户ID"
        },
        "user_uid": {
            "type": "string",
            "description": "TikTok评论者用户UID"
        },
        "user_nickname": {
            "type": "string",
            "description": "TikTok评论者昵称"
        },
        "user_sec_uid": {
            "type": "string",
            "description": "TikTok评论者SEC_UID"
        },
        "reply_comment_total": {
            "type": "number",
            "description": "TikTok评论回复数"
        }
    }
}