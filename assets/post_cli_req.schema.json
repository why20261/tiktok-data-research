{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "title": "TikTok博主作品获取 - 命令行入参",
    "description": "TikTok实时获取博主作品, 命令行参数入参Schema详解",
    "required": [
        "url"
    ],
    "properties": {
        "url": {
            "type": "string",
            "description": "TikTok博主主页URL 或 TikTok博主SEC_UID"
        },
        "sort": {
            "type": "number",
            "description": "排序方式: 0 = 最新 , 1 = 最热",
            "default": 0,
            "enum": [
                0,
                1
            ]
        },
        "limit": {
            "type": "number",
            "description": "获取作品数量",
            "minimum": 1,
            "maximum": 10000,
            "default": 10
        }
    },
    "additionalProperties": false
}